      "UpdateAssociationBankAccountRequest" : {
        "properties" : {
          "accountHolder" : {
            "maxLength" : 70,
            "minLength" : 0,
            "type" : "string"
          },
          "bankName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "iban" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "accountHolder", "bankName", "iban" ],
        "type" : "object"
      },
      "UpdateMailSettingsRequest" : {
        "properties" : {
          "from" : {
            "description" : "Absenderadresse; bei Gmail die Gmail-Adresse oder ein dort eingerichteter Alias",
            "maxLength" : 254,
            "minLength" : 0,
            "pattern" : "\\s*[^\\s@<>,;\"]+@[^\\s@<>,;\"]+\\.[^\\s@<>,;\"]+\\s*",
            "type" : "string"
          },
          "host" : {
            "example" : "smtp.gmail.com",
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "\\s*[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\\s*",
            "type" : "string"
          },
          "password" : {
            "description" : "Neues Passwort (bei Gmail das App-Passwort). Fehlt es oder ist es leer, bleibt das gespeicherte. Wird nie zurückgegeben.",
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string",
            "writeOnly" : true
          },
          "port" : {
            "example" : 587,
            "format" : "int32",
            "maximum" : 65535,
            "minimum" : 1,
            "type" : "integer"
          },
          "startTls" : {
            "description" : "STARTTLS erzwingen; Standard true",
            "example" : true,
            "type" : "boolean"
          },
          "username" : {
            "description" : "Anmeldename; bei Gmail die Gmail-Adresse. Leer = ohne Anmeldung",
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "from", "host", "port" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "Access Token aus POST /v1/auth/login (Rolle ADMIN)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "contact" : {
      "name" : "MaridCam Team",
      "url" : "https://github.com/anomalyco/maridcam-backend"
    },
    "description" : "REST-API für die MaridCam Plattform – Studentenregistrierung, Gebetszeiten, Admin-Login und Barzahlungs-Quittungen.",
    "title" : "MaridCam Backend API",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/v1/admin/association-bank-account" : {
      "put" : {
        "description" : "Ersetzt die eine gespeicherte Bankverbindung. 400 VALIDATION_FAILED bei ungültiger IBAN (Format/Prüfsumme), leeren oder zu langen Feldern und bei Platzhaltertexten in eckigen Klammern. Antwort wie GET /v1/association-bank-account, immer mit configured=true.",
        "operationId" : "update_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateAssociationBankAccountRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AssociationBankAccountResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Bankverbindung ersetzen",
        "tags" : [ "Admin – Bankverbindung" ]
      }
    },
    "/v1/admin/cash-payers" : {
      "get" : {
        "description" : "Nur Registrierungen mit paymentMethod = CASH; query sucht case-insensitive in Vor-/Nachname der Person und der Erziehungsberechtigten. Sortierung Nachname, Vorname.",
        "operationId" : "search",
        "parameters" : [ {
          "in" : "query",
          "name" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CashPayerPageResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Barzahler suchen",
        "tags" : [ "Admin – Barzahlungen" ]
      }
    },
    "/v1/admin/cash-receipts/{receiptIdentifier}/cancellation" : {
      "post" : {
        "description" : "Markiert die Quittung als storniert (Grund, Zeitpunkt, Bearbeiter aus dem Token). Quittung und Datei bleiben unverändert gespeichert, die Quittungsnummer bleibt vergeben, die Monate gelten wieder als offen. Nicht umkehrbar. Body: {\"reason\": \"...\"} (1–500 Zeichen). 200 = aktualisierte Quittung, 400 VALIDATION_FAILED (reason), 404 RECEIPT_NOT_FOUND, 409 RECEIPT_ALREADY_CANCELLED.",
        "operationId" : "cancel",
        "parameters" : [ {
          "in" : "path",
          "name" : "receiptIdentifier",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CashReceiptCancellationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CashReceiptResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Quittung stornieren",
        "tags" : [ "Admin – Barzahlungen" ]
      }
    },
    "/v1/admin/cash-receipts/{receiptIdentifier}/file" : {
      "get" : {
        "description" : "Original-Bytes als Download, auch für stornierte Quittungen. 404 RECEIPT_NOT_FOUND.",
        "operationId" : "file",
        "parameters" : [ {
          "in" : "path",
          "name" : "receiptIdentifier",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Quittungsdatei abrufen",
        "tags" : [ "Admin – Barzahlungen" ]
      }
    },
    "/v1/admin/mail-settings" : {
      "get" : {
        "description" : "Liefert die gespeicherten Einstellungen ohne Passwort (nur passwordSet). Ohne gespeicherte Einstellungen: host/username/from leer, port 587, startTls true, configured=false.",
        "operationId" : "get",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MailSettingsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "E-Mail-Einstellungen lesen",
        "tags" : [ "Admin – E-Mail-Einstellungen" ]
      },
      "put" : {
        "description" : "Ersetzt die gespeicherten Einstellungen. Das Passwort wird verschlüsselt gespeichert; fehlt es oder ist es leer, bleibt das bisherige. Mit username ist ein Passwort Pflicht (400 VALIDATION_FAILED, Feld password). Antwort wie GET, ohne Passwort. Es wird keine Test-Mail versendet.",
        "operationId" : "update",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateMailSettingsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MailSettingsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
